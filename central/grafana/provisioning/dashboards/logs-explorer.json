{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "title": "Logs Explorer",
  "uid": "logs-explorer",
  "tags": ["monitoring", "logs"],
  "timezone": "",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(host)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({host=~\"$host\"}, container_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log volume",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host, container_name) (rate({host=~\"$host\", container_name=~\"$container\"}[1m]))",
          "legendFormat": "{{host}} / {{container_name}}"
        }
      ],
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\", container_name=~\"$container\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 6 }
    }
  ]
}
